# Copy to .env and fill in. NEVER commit real secrets.

# ---- App ----
NODE_ENV=production
PORT=3000
# Public base URL used for canonical URLs / sitemap
NEXT_PUBLIC_SITE_URL=https://bushmanbiltong.xscapebot.tech

# ---- Database ----
# Path to the SQLite database file inside the container
DATABASE_PATH=/app/data/biltong.db

# ---- Session / auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-64-hex-chars
# Days until an admin session expires
SESSION_TTL_DAYS=7

# ---- Admin bootstrap ----
# Used by `npm run admin:create` to create the first admin. Delete after use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Business config (owner-supplied values; safe to commit placeholders) ----
BUSINESS_NAME=Bushman Biltong
BUSINESS_EMAIL=orders@bushmanbiltong.com
BUSINESS_PHONE=
PICKUP_ENABLED=true
PICKUP_NAME=Pickup location TBC
PICKUP_ADDRESS=
PICKUP_INSTRUCTIONS=Pickup details will be confirmed by email or phone after your order is received.
DELIVERY_ENABLED=true
# Comma-separated Australian postcodes allowed for local delivery
DELIVERY_POSTCODES=
DELIVERY_SUBURBS=
# Integer cents
DELIVERY_FEE_CENTS=0
FREE_DELIVERY_THRESHOLD_CENTS=0
DELIVERY_MIN_ORDER_CENTS=0
DELIVERY_INSTRUCTIONS=

# ---- Email (v1: not implemented; stub for later) ----
EMAIL_PROVIDER=none
# RESEND_API_KEY=

# ---- Traefik / deployment (compose reads these; documented in docs/deployment.md) ----
# TRAEFIK_HOST=bushmanbiltong.xscapebot.tech
